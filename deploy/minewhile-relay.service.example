[Unit]
Description=Minewhile Stratum Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minewhile
Group=minewhile
WorkingDirectory=/opt/minewhile/relay
EnvironmentFile=/etc/minewhile/relay.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/minewhile/relay/dist/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
